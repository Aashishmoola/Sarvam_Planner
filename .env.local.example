# Supabase — copy this file to .env.local and fill in real values from your project.
# Get these from: Supabase Dashboard → Settings → API Keys → "Publishable and secret API keys".
# Supabase has deprecated the legacy anon/service_role keys in favour of
# publishable (sb_publishable_…) and secret (sb_secret_…) keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-PUBLISHABLE-KEY

# Secret key — only for the midnight auto-fail Edge Function (server-side,
# bypasses RLS). Do NOT expose this to the browser (no NEXT_PUBLIC_ prefix).
# Set it as a secret on the Edge Function in the Supabase dashboard.
SUPABASE_SERVICE_KEY=sb_secret_YOUR-SECRET-KEY

# VAPID keys for Web Push (generated in Phase D — leave blank for now).
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
